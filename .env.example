# .env 로 복사해서 쓰세요.  cp .env.example .env
# 카카오모빌리티 REST API 키 — https://developers.kakao.com 에서 발급
#   내 애플리케이션 → 앱 만들기 → 앱 키 → REST API 키
#   제품 설정 → 카카오맵/모빌리티 길찾기 활성화 필요
KAKAO_REST_API_KEY=

# VWorld 배경지도 — https://www.vworld.kr/dev/v4api.do
#   인증키 발급 시 사용할 도메인을 등록해야 한다 (localhost 포함)
#   없으면 배경지도가 Carto 로 물러선다
VWORLD_API_KEY=

# 카카오맵 배경지도 — JavaScript 키 (REST 키와 다름)
#   플랫폼 → Web → 사이트 도메인 등록 필요 (localhost 포함)
KAKAO_JS_KEY=
